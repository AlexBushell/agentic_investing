# App environment
APP_ENV=development
LOG_LEVEL=INFO

# Local storage
DATA_DIR=./data

# Database
# Native Windows PostgreSQL example:
# postgresql+psycopg://postgres:yourpassword@localhost:5432/company_intelligence
DATABASE_URL=postgresql+psycopg://postgres:change_me@localhost:5432/company_intelligence

# PostgreSQL extension expectations
# Keep enabled when pgvector is installed. The first slice can still work
# without embeddings if extension setup is delayed.
PGVECTOR_ENABLED=true

# LLM provider
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.5

# Framework runner defaults
DEFAULT_FRAMEWORK=IVF_PRE_SCREEN

# Document ingestion and NSM browser automation
DEFAULT_EXCHANGE=LSE
NSM_CONFIG_PATH=./config/nsm.yaml

# Playwright browser choice
# Leave blank to use bundled Chromium. Set to chrome or msedge if preferred.
BROWSER_CHANNEL=
